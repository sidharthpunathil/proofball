# ─────────────────────────────────────────────────────────────
# PRODUCTION env, COMMITTED TEMPLATE (safe: placeholders only).
# Copy to `.env.production` (gitignored) or set each var in Vercel.
# See docs/FLOW.md → "Environment & secrets" for what each does.
# ─────────────────────────────────────────────────────────────

DEMO_MODE=live

# Public (safe on client)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Canonical origin for SEO metadata (OG/Twitter, robots, sitemap). Falls back to
# RAILWAY_PUBLIC_DOMAIN, then https://proofball.xyz. Set to the live domain.
NEXT_PUBLIC_SITE_URL=https://proofball.xyz

# Sign-In-With-Solana: require a verified wallet signature on airdrop + leaderboard.
# RECOMMENDED "true" in production (closes Sybil airdrop farming + leaderboard
# spoofing). Requires the client wired to sign (lib/siws-client.ts). Kept "false"
# until that wiring lands so the live demo keeps working. See docs/SECURITY-AUDIT.md.
AUTH_REQUIRED=false

# Admin secret gating GET /api/admin/airdrops (the welcome-airdrop ledger).
# Set to a long random string; unset = the route 404s.
ADMIN_TOKEN=

# TxLINE
TXLINE_API_BASE=https://txline-dev.txodds.com/api
TXLINE_AUTH_URL=https://txline-dev.txodds.com/auth/guest/start
WORLDCUP_COMPETITION_ID=72

# On-chain constants
TXORACLE_PROGRAM_ID=6pW64gN1s2uqjHkn1unFeEjAwJkPGHoppGvS715wyP2J
TXL_MINT=4Zao8ocPhmMgq7PdsYWyxvqySMGx7xb9cMftPMkEokRG
SOLANA_RPC_URL=

# Secrets, set in Vercel, do NOT commit real values
SESSION_SECRET=
PRIVY_APP_SECRET=
FEE_PAYER_SECRET_KEY=
TXLINE_GUEST_JWT=
TXLINE_API_TOKEN=
TXLINE_SUBSCRIBE_TXSIG=
TXLINE_FIXTURE_ID=
