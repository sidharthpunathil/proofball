# ─────────────────────────────────────────────────────────────
# ProofBall environment. Copy to `.env.local` and fill in.
# The app RUNS WITHOUT ANY OF THESE in demo/replay mode.
# Add them only when you switch on the live TxLINE + Solana paths.
# ─────────────────────────────────────────────────────────────

# Data mode: "replay" (bundled sample feed, no creds needed) or "live" (real TxLINE SSE)
DEMO_MODE=replay

# ── SERVER ONLY (never prefix with NEXT_PUBLIC_) ──────────────
# TxLINE devnet
TXLINE_API_BASE=https://txline-dev.txodds.com/api
TXLINE_AUTH_URL=https://txline-dev.txodds.com/auth/guest/start
# These are obtained at runtime by the auth chain (see ProofBall.md §5), leave blank
# unless you are pinning a pre-activated token during development.
TXLINE_GUEST_JWT=
TXLINE_API_TOKEN=
# Fixture you want to stream in live mode
TXLINE_FIXTURE_ID=
# One-time on-chain subscribe txSig (from `npm run txline:auth`)
TXLINE_SUBSCRIBE_TXSIG=

# Solana devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
FEE_PAYER_SECRET_KEY=
TXORACLE_PROGRAM_ID=6pW64gN1s2uqjHkn1unFeEjAwJkPGHoppGvS715wyP2J
TXL_MINT=4Zao8ocPhmMgq7PdsYWyxvqySMGx7xb9cMftPMkEokRG
WORLDCUP_COMPETITION_ID=72

# ── DATA STORES (docker compose; odd ports so they don't collide) ──
# `docker compose up -d` starts both. These defaults are also baked into
# lib/db.ts / lib/redis.ts, so you only need to set them to point elsewhere.
DATABASE_URL=postgresql://proofball:proofball@localhost:55432/proofball
REDIS_URL=redis://localhost:63799

SESSION_SECRET=change-me-to-a-random-string

# ── AUTH: Sign-In-With-Solana (server-verified wallet ownership) ──
# "true" requires a wallet signature on the airdrop + leaderboard routes, which
# closes Sybil airdrop farming and leaderboard spoofing (see docs/SECURITY-AUDIT.md).
# Requires the client to be wired to sign the nonce (lib/siws-client.ts).
# Leave "false" for the frictionless demo; set "true" in production.
AUTH_REQUIRED=false

# ── ADMIN: view the welcome-airdrop ledger ────────────────────
# Secret that gates GET /api/admin/airdrops (who got the airdrop, amounts, tx,
# totals). Pass it as an `x-admin-token` header or `?token=`. Unset = route 404s.
ADMIN_TOKEN=

# ── CLIENT (safe to expose) ───────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Canonical origin for SEO metadata (metadataBase, OG/Twitter URLs, robots,
# sitemap). Optional locally. On Railway, RAILWAY_PUBLIC_DOMAIN is used if unset;
# falls back to https://proofball.xyz. Set to the production domain in prod.
# NEXT_PUBLIC_SITE_URL=https://proofball.xyz

# $PROOF reward token mint (fill after `npm run token:create`)
NEXT_PUBLIC_PROOF_MINT=
